
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"

             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"

             x:Class="PaymentAppTester.Views.SettingsView"

             xmlns:vm="clr-namespace:PaymentAppTester.ViewModels"

             x:DataType="vm:SettingsViewModel"

             Title="Настройки">

    <VerticalStackLayout Spacing="15" Padding="25" VerticalOptions="Center">

        <Label Text="Настройки подключения" FontSize="Header" HorizontalOptions="Center" />

        <Entry Placeholder="http://10.0.2.2:5000" Text="{Binding ApiUrl}" Keyboard="Url" />

        <Label Text="Подсказка: для эмулятора Android используйте 10.0.2.2 для доступа к localhost. Для реального устройства - IP компьютера в Wi-Fi сети." FontSize="Caption" />

        <Button Text="Сохранить и проверить" Command="{Binding SaveCommand}" />

        <Label Text="{Binding StatusMessage}" TextColor="{Binding StatusColor}" HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>