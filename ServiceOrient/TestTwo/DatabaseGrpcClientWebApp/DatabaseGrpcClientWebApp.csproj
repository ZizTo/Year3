<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.32.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.49.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.49.0" />
    <PackageReference Include="Grpc.Net.Client.Web" Version="2.71.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\DatabaseGrpcService\Protos\database.proto" GrpcServices="Client">
      <Link>Protos\database.proto</Link>
    </Protobuf>
  </ItemGroup>

</Project>
