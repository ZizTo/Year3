<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{YYYY-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Устанавливаем уровень логирования для Hibernate на ERROR, чтобы не засорять консоль -->
    <logger name="org.hibernate" level="ERROR" />
    <!-- Уровень DEBUG для наших пакетов, чтобы видеть подробную информацию -->
    <logger name="com.zizto" level="DEBUG" />

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
