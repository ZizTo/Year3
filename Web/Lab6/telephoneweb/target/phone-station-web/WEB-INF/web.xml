<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
  <display-name>Phone Station Web App</display-name>

  <!-- 1. Фильтр Безопасности -->
  <filter>
    <filter-name>SecurityFilter</filter-name>
    <filter-class>com.zizto.controller.SecurityFilter</filter-class>
  </filter>

  <!-- 2. Главный Контроллер -->
  <filter>
    <filter-name>FrontController</filter-name>
    <filter-class>com.zizto.controller.FrontControllerFilter</filter-class>
  </filter>

  <!-- Mappings -->
  <filter-mapping>
    <filter-name>SecurityFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter-mapping>
    <filter-name>FrontController</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

</web-app>
